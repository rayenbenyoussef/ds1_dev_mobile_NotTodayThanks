<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    tools:context=".VerificationActivity">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0.3"
        tools:srcCompat="@tools:sample/avatars" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.7">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="131dp"
            android:layout_marginTop="192dp"
            android:text="2026"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_nom_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="91dp"
            android:layout_marginTop="29dp"
            android:layout_marginEnd="90dp"
            android:text="john doe"
            android:textAlignment="center"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tv_ad_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="84dp"
            android:layout_marginTop="458dp"
            android:text="2112"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/imageView312"
            android:layout_width="286dp"
            android:layout_height="75dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="9dp"
            tools:srcCompat="@drawable/barcode" />

        <TextView
            android:id="@+id/tv_moif_rby"
            android:layout_width="292dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="339dp"
            android:layout_marginEnd="-99dp"
            android:rotation="90"
            android:text="Modification du passé"
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_age_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_nom_rby"
            android:layout_alignStart="@+id/tv_nom_rby"
            android:layout_alignEnd="@+id/tv_nom_rby"
            android:layout_marginStart="39dp"
            android:layout_marginTop="17dp"
            android:layout_marginEnd="41dp"
            android:text="21 ans"
            android:textSize="20sp" />

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/imageView312"
            android:layout_alignParentStart="true"
            android:layout_marginStart="50dp"
            android:layout_marginBottom="38dp"
            android:text="Button" />

        <Button
            android:id="@+id/button2"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/button"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="27dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="56dp"
            android:layout_toEndOf="@+id/button"
            android:text="Button" />
    </RelativeLayout>
</LinearLayout>