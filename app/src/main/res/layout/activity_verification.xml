<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    android:background="@drawable/bg"
    tools:context=".VerificationActivity">

    <ImageView
        android:id="@+id/imgv_ver_rby"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:paddingTop="50dp"
        android:scaleType="fitStart"
        android:src="@drawable/pastmod" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="67dp"
            android:layout_marginTop="198dp"
            android:text="from 2026"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_nom_rby"
            android:layout_width="143dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="71dp"
            android:text="john doe"
            android:textAlignment="center"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tv_ad_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="30dp"
            android:layout_marginTop="411dp"
            android:text="to 2112"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/imageView312"
            android:layout_width="286dp"
            android:layout_height="75dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="11dp"
            android:layout_marginBottom="11dp"
            android:src="@drawable/barcode" />

        <TextView
            android:id="@+id/tv_moif_rby"
            android:layout_width="292dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="325dp"
            android:layout_marginEnd="-104dp"
            android:rotation="90"
            android:text="Modification du passé"
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_age_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_nom_rby"
            android:layout_alignStart="@+id/tv_nom_rby"
            android:layout_alignEnd="@+id/tv_nom_rby"
            android:layout_marginStart="5dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="75dp"
            android:text="21 ans"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_aprv_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/imageView312"
            android:layout_alignParentStart="true"
            android:layout_marginStart="19dp"
            android:layout_marginBottom="41dp"
            android:onClick="approve"
            android:text="Approuver" />

        <Button
            android:id="@+id/btn_ref_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/btn_aprv_rby"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-1dp"
            android:layout_marginEnd="30dp"
            android:onClick="refuse"
            android:text="Refuser" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="221dp"
            android:layout_height="236dp"
            android:layout_below="@+id/textView2"
            android:layout_alignParentStart="true"
            android:layout_marginStart="9dp"
            android:layout_marginTop="-15dp"
            android:rotation="129"
            android:src="@drawable/arrow_removebg" />
    </RelativeLayout>
</LinearLayout>