<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    android:background="@drawable/bg"
    tools:context=".VerificationActivity">

    <ImageView
        android:id="@+id/imgv_ver_rby"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:scaleType="fitXY"
        android:src="@drawable/pastmod" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:backgroundTint="#FFFFFF">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="42dp"
            android:layout_marginTop="283dp"
            android:text="from 2026"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_nom_rby"
            android:layout_width="175dp"
            android:layout_height="48dp"
            android:layout_below="@+id/textView3"
            android:layout_alignParentStart="true"
            android:layout_marginStart="23dp"
            android:layout_marginTop="2dp"
            android:text="john doe"
            android:textAlignment="inherit"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tv_ad_rby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView2"
            android:layout_alignParentStart="true"
            android:layout_marginStart="50dp"
            android:layout_marginTop="141dp"
            android:text="to 2112"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_moif_rby"
            android:layout_width="292dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="381dp"
            android:layout_marginEnd="-95dp"
            android:rotation="90"
            android:text="Modification du passé"
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_age_rby"
            android:layout_width="146dp"
            android:layout_height="40dp"
            android:layout_below="@+id/textView4"
            android:layout_alignStart="@+id/tv_nom_rby"
            android:layout_alignEnd="@+id/tv_nom_rby"
            android:layout_marginStart="0dp"
            android:layout_marginTop="-3dp"
            android:layout_marginEnd="-2dp"
            android:text="21 ans"
            android:textSize="34sp" />

        <Button
            android:id="@+id/btn_aprv_rby"
            android:layout_width="221dp"
            android:layout_height="60dp"
            android:layout_above="@+id/btn_ref_rby"
            android:layout_alignParentStart="true"
            android:layout_marginStart="23dp"
            android:layout_marginBottom="13dp"
            android:backgroundTint="#D9E1F7"
            android:onClick="approve"
            android:text="Approuver"
            android:textColor="@color/green"
            app:cornerRadius="10dp"
            app:strokeColor="@color/green"
            app:strokeWidth="4dp" />

        <Button
            android:id="@+id/btn_ref_rby"
            android:layout_width="221dp"
            android:layout_height="60dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#D9E1F7"
            android:onClick="refuse"
            android:text="Refuser"
            android:textColor="@color/red"
            app:cornerRadius="10dp"
            app:strokeColor="@color/red"
            app:strokeWidth="4dp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="14dp"
            android:layout_marginTop="48dp"
            android:text="Nom"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_nom_rby"
            android:layout_alignStart="@+id/textView3"
            android:layout_marginStart="1dp"
            android:layout_marginTop="15dp"
            android:text="Age"
            android:textSize="24sp" />

    </RelativeLayout>
</LinearLayout>